@page
@model ErrorModel
@{
    ViewData["Title"] = Model.IsNotFound ? "Pagina niet gevonden" : "Er ging iets mis";
}

<div class="page-header">
    <h1 class="tab-title">@ViewData["Title"]</h1>
</div>

<div class="card empty-state">
    @if (Model.IsNotFound)
    {
        <p>Deze pagina bestaat niet (meer). Controleer het adres of ga terug naar de homepage.</p>
    }
    else
    {
        <p>Er is een fout opgetreden bij het verwerken van uw verzoek. Probeer het later opnieuw.</p>
        @if (Model.ShowRequestId && !Model.StatusCodeValue.HasValue)
        {
            <p class="field-hint">Foutcode: <code>@Model.RequestId</code></p>
        }
    }
    <a class="button button--dark" asp-page="/Index">Naar de homepage</a>
</div>

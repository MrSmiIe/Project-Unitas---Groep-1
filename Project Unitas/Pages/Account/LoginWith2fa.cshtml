@page
@model Project_Unitas.Pages.Account.LoginWith2faModel
@{
    ViewData["Title"] = "Tweestapsverificatie";
}

<div class="page-header">
    <h1 class="tab-title">Tweestapsverificatie</h1>
</div>

<div class="form-narrow">
    <section class="card">
        <p>Open uw authenticator-app en vul de code van 6 cijfers in die bij <strong>Unitas</strong> staat.</p>

        <form class="form" method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>

            <div class="field">
                <label asp-for="Code"></label>
                <input asp-for="Code" autocomplete="one-time-code" inputmode="numeric" autofocus />
                <span asp-validation-for="Code" class="field-error"></span>
            </div>

            <button class="button button--dark" type="submit">Inloggen</button>
        </form>
    </section>

    <p class="form-footer">
        Telefoon kwijt? <a class="link" asp-page="/Account/LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Log in met een herstelcode</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

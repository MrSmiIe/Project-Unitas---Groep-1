@page
@model Project_Unitas.Pages.Account.LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Inloggen met herstelcode";
}

<div class="page-header">
    <h1 class="tab-title">Inloggen met herstelcode</h1>
</div>

<div class="form-narrow">
    <section class="card">
        <p>
            Vul een van de herstelcodes in die u kreeg bij het instellen van tweestapsverificatie.
            Elke code werkt maar één keer.
        </p>

        <form class="form" method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>

            <div class="field">
                <label asp-for="RecoveryCode"></label>
                <input asp-for="RecoveryCode" autocomplete="off" autofocus />
                <span asp-validation-for="RecoveryCode" class="field-error"></span>
            </div>

            <button class="button button--dark" type="submit">Inloggen</button>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
